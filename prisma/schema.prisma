generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model House {
  id            Int      @id @default(autoincrement())

  houseType     String
  title         String
  folder        String

  length        Float
  width         Float

  foundation    Int
  complete      Int

  image3d       String?
  image2d       String?

  status        String   @default("Published")
  isFeatured    Boolean  @default(false)

  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  downloads     Int      @default(0)
  trendingScore Float    @default(0)

  images        HouseImage[]
  keywords      HouseKeyword[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([houseType])
  @@index([folder])
  @@index([foundation])
  @@index([complete])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([houseType, complete])
  @@index([houseType, foundation])
  @@index([houseType, status])
  @@index([houseType, createdAt])
}

model HouseImage {
  id         Int      @id @default(autoincrement())

  houseId    Int
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  type       String
  image      String
  sortOrder  Int      @default(1)

  createdAt  DateTime @default(now())

  @@index([houseId])
  @@index([type])
  @@index([houseId, type])
}

model HouseKeyword {
  id         Int      @id @default(autoincrement())

  houseId    Int
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  language   String
  keyword    String

  createdAt  DateTime @default(now())

  @@index([houseId])
  @@index([language])
  @@index([keyword])
  @@index([houseId, language])
}

model Admin {
  id        Int      @id @default(autoincrement())

  username  String   @unique
  password  String

  createdAt DateTime @default(now())
}