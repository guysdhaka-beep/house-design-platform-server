generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model House {
  id            Int            @id @default(autoincrement())
  houseType     String
  title         String
  folder        String
  length        Float
  width         Float
  foundation    Int
  complete      Int
  status        String         @default("Published")
  views         Int            @default(0)
  likes         Int            @default(0)
  comments      Int            @default(0)
  shares        Int            @default(0)
  saves         Int            @default(0)
  downloads     Int            @default(0)
  trendingScore Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isFeatured    Boolean        @default(false)
  image2d       String?
  image3d       String?
  area          Float?
  backGarden    Boolean        @default(false)
  balcony       Int            @default(0)
  bathroom      Int            @default(0)
  bedroom       Int            @default(0)
  designStyle   String?
  diningRoom    Int            @default(0)
  frontGarden   Boolean        @default(false)
  garage        Boolean        @default(false)
  kitchen       Int            @default(0)
  language      String         @default("bn")
  lengthInches  Int            @default(0)
  lift          Boolean        @default(false)
  livingRoom    Int            @default(0)
  servantRoom   Boolean        @default(false)
  stair         Int            @default(0)
  swimmingPool  Boolean        @default(false)
  terrace       Boolean        @default(false)
  widthInches   Int            @default(0)
  images        HouseImage[]
  keywords      HouseKeyword[]

  @@index([houseType])
  @@index([folder])
  @@index([foundation])
  @@index([complete])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([designStyle])
  @@index([language])
  @@index([houseType, complete])
  @@index([houseType, foundation])
  @@index([houseType, status])
  @@index([houseType, createdAt])
}

model HouseImage {
  id          Int      @id @default(autoincrement())
  houseId     Int
  type        String
  image       String
  sortOrder   Int      @default(1)
  createdAt   DateTime @default(now())
  altText     String?
  caption     String?
  description String?
  fileName    String?
  imageTitle  String?
  keywords    String[] @default([])
  house       House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
  @@index([type])
  @@index([houseId, type])
}

model HouseKeyword {
  id        Int      @id @default(autoincrement())
  houseId   Int
  language  String
  keyword   String
  createdAt DateTime @default(now())
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
  @@index([language])
  @@index([keyword])
  @@index([houseId, language])
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
